{
  "name": "codex-plugin-dsh",
  "version": "0.1.0",
  "description": "Codex App Server model provider plugin for DeepSeek Harness",
  "keywords": [
    "codex",
    "deepseek-harness",
    "dsh-plugin",
    "app-server",
    "agent-runtime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wingoo/codex-plugin-dsh.git"
  },
  "homepage": "https://github.com/wingoo/codex-plugin-dsh#readme",
  "bugs": {
    "url": "https://github.com/wingoo/codex-plugin-dsh/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir lib --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run tests/live.spec.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-sandbox": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-scope": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-sdk-protocol": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-timeout": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  }
}
